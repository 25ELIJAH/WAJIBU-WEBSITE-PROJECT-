# Public origin of the site (used for metadata, sitemap.xml and robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.wajibu.co.uk

# ─── Charity portal ───────────────────────────────────────────────────────────
# Database. SQLite for local development; use a managed Postgres in production
# (change `provider` in prisma/schema.prisma and set this to the Postgres URL).
DATABASE_URL="file:./dev.db"

# Signs session cookies. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# First WAJIBU administrator, created by `npm run db:seed`. Never commit the real password.
ADMIN_EMAIL=Admin1@wajibu.uk
ADMIN_NAME="Samuel Orie"
ADMIN_PASSWORD=

# Email (optional). Without a key, notifications still appear in the portal and emails are logged only.
RESEND_API_KEY=
MAIL_FROM="WAJIBU <no-reply@wajibu.uk>"
NOTIFY_EMAIL=Admin1@wajibu.uk

# ─── AI features (not used yet; see src/app/api/chat/route.ts) ────────────────
ANTHROPIC_API_KEY=
AI_MODEL=
