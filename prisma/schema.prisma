// WAJIBU charity–company portal data model.
//
// SQLite keeps local development zero-config. For production (Vercel/Netlify are serverless, so a
// file database will not persist) switch `provider` to "postgresql", point DATABASE_URL at a managed
// Postgres (Neon, Supabase, Railway, ...) and run `npx prisma migrate deploy`. No other change needed:
// enums are stored as plain strings and validated in code (src/lib/portal/constants.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A charity or a company. Created by WAJIBU when an access request is approved.
model Organisation {
  id         String   @id @default(cuid())
  type       String // CHARITY | COMPANY
  name       String
  country    String
  status     String   @default("APPROVED") // APPROVED | SUSPENDED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users      User[]
  charity    CharityProfile?
  company    CompanyProfile?

  shortlist  Shortlist[]   @relation("CompanyShortlist")
  connections Connection[] @relation("CompanyConnections")
  deletionRequests DeletionRequest[]

  @@index([type])
}

/// One administrator login per organisation (chosen by WAJIBU). WAJIBU staff have role ADMIN and no organisation.
model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  name               String
  passwordHash       String
  role               String // ADMIN | CHARITY | COMPANY
  mustChangePassword Boolean      @default(true)
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  lastLoginAt        DateTime?
  /// Sessions issued before this moment are rejected (set when the password is changed or reset).
  sessionsValidFrom  DateTime?
  passwordResets     PasswordReset[]
  organisationId     String?
  organisation       Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  notifications      Notification[]

  @@index([organisationId])
}

model CharityProfile {
  id               String       @id @default(cuid())
  organisationId   String       @unique
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  registeredNumber String? // shown in the profile summary
  summary          String       @default("")
  /// comma separated list of sector keys (see SECTORS)
  sectors          String       @default("")
  /// 0-5; drives ordering together with `featured`
  complianceLevel  Int          @default(0)
  featured         Boolean      @default(false)
  published        Boolean      @default(false) // shown in the directory only when WAJIBU publishes it
  photos           Photo[]
  views            ProfileView[]
  shortlisted      Shortlist[]
  connections      Connection[]
  updatedAt        DateTime     @updatedAt

  @@index([featured, complianceLevel])
}

model CompanyProfile {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  industry       String       @default("")
  /// free text values/priorities; input for the future AI matching feature
  values         String       @default("")
}

/// Photos are managed by WAJIBU administrators only.
model Photo {
  id        String         @id @default(cuid())
  charityId String
  charity   CharityProfile @relation(fields: [charityId], references: [id], onDelete: Cascade)
  file      String // opaque id used in the authenticated image URL
  /// The image bytes live in the database, so photos work on any host (including serverless) and are
  /// only ever served through the permission-checked route /api/portal/photo/<file>.
  data      Bytes?
  mime      String         @default("image/jpeg")
  caption   String         @default("")
  sort      Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([charityId])
}

model Shortlist {
  id         String         @id @default(cuid())
  companyId  String
  company    Organisation   @relation("CompanyShortlist", fields: [companyId], references: [id], onDelete: Cascade)
  charityId  String
  charity    CharityProfile @relation(fields: [charityId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([companyId, charityId])
}

/// A company asked WAJIBU to connect it with a charity. WAJIBU takes over from here.
model Connection {
  id         String         @id @default(cuid())
  companyId  String
  company    Organisation   @relation("CompanyConnections", fields: [companyId], references: [id], onDelete: Cascade)
  charityId  String
  charity    CharityProfile @relation(fields: [charityId], references: [id], onDelete: Cascade)
  status     String         @default("NEW") // NEW | IN_PROGRESS | CLOSED
  note       String         @default("")
  adminNote  String         @default("")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status])
  @@index([charityId])
}

model ProfileView {
  id         String         @id @default(cuid())
  charityId  String
  charity    CharityProfile @relation(fields: [charityId], references: [id], onDelete: Cascade)
  companyId  String
  createdAt  DateTime       @default(now())

  @@index([charityId, createdAt])
}

/// Public "request access" form submissions, reviewed by WAJIBU.
model AccessRequest {
  id          String   @id @default(cuid())
  type        String // CHARITY | COMPANY
  orgName     String
  country     String
  contactName String
  email       String
  phone       String   @default("")
  registeredNumber String @default("")
  message     String   @default("")
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())
  decidedAt   DateTime?

  @@index([status])
}

/// An organisation asks WAJIBU to delete its account. Organisations cannot delete anything themselves;
/// a WAJIBU administrator reviews the request and deletes (or declines).
model DeletionRequest {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  requestedBy    String // user id
  reason         String       @default("")
  status         String       @default("PENDING") // PENDING | DECLINED
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?

  @@index([status])
}

/// Sector / category tags that can be put on a charity. Managed by WAJIBU in Admin → Sectors.
/// A charity stores the keys it carries as a comma-separated list (CharityProfile.sectors).
model Sector {
  id     String  @id @default(cuid())
  key    String  @unique // url-safe slug, never changes once created
  label  String
  active Boolean @default(true) // inactive sectors are hidden from filters and from new tagging
  sort   Int     @default(0)
}

/// One-time "forgot password" links. Only a SHA-256 hash of the token is stored, never the token itself.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @default("")
  href      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([action, detail, createdAt])
}
